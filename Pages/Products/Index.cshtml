@page
@model RealCoreBanking.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Продукты";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Продукты</h4>
    <a asp-page="/Products/Create" class="btn btn-primary">+ Создать продукт</a>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@Model.Search"
           placeholder="Поиск по коду или названию..."
           class="form-control" style="max-width:380px" />
    <button type="submit" class="btn btn-outline-secondary">Поиск</button>
    @if (!string.IsNullOrEmpty(Model.Search))
    {
        <a asp-page="/Products/Index" class="btn btn-outline-secondary">Сброс</a>
    }
</form>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">
        Продуктов нет.
        <a asp-page="/Products/Create">Создайте первый продукт</a>.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Код</th>
                        <th>Название</th>
                        <th>База начисл.</th>
                        <th>Тип баланса</th>
                        <th class="text-center">GL кодов</th>
                        <th class="text-center">Ставок</th>
                        <th class="text-center">Адресов долга</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr>
                            <td class="mono fw-bold">@p.Code</td>
                            <td>@p.Name</td>
                            <td><span class="badge bg-info text-dark">@p.AccrualBasis</span></td>
                            <td>
                                @{
                                    var btCls = p.BalanceType switch {
                                        RealCoreBanking.Core.Enums.BalanceAccountType.Active   => "bg-success",
                                        RealCoreBanking.Core.Enums.BalanceAccountType.Passive  => "bg-primary",
                                        RealCoreBanking.Core.Enums.BalanceAccountType.OffBalance => "bg-secondary",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @btCls">@p.BalanceType</span>
                            </td>
                            <td class="text-center">@p.GlCodes.Count</td>
                            <td class="text-center">@p.Rates.Count</td>
                            <td class="text-center">@p.DebtBalanceAddresses.Count</td>
                            <td>
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-page="/Products/Details" asp-route-code="@p.Code"
                                       class="btn btn-sm btn-outline-primary">Открыть →</a>
                                    <form method="post" asp-page-handler="Delete" class="m-0"
                                          onsubmit="return confirm('Удалить продукт @p.Code (@p.Name)?')">
                                        <input type="hidden" name="code" value="@p.Code" />
                                        <button class="btn btn-sm btn-outline-danger">✕</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
