@page "{code:int}"
@model RealCoreBanking.Pages.Products.DetailsModel
@using RealCoreBanking.Core.Enums
@using RealCoreBanking.Core.Models
@using System.Linq
@{
    ViewData["Title"] = $"Продукт {Model.Product?.Code}";
    var p    = Model.Product!;
    var edit = Model.EditMode;

    var balanceGroups = p.ProductBalances
        .OrderBy(b => b.CurrencyCode)
        .ThenBy(b => b.BalanceCode)
        .GroupBy(b => b.CurrencyCode)
        .ToList();
}

<style>
    .info-box   { border:1px solid #dee2e6; border-radius:.375rem; padding:.375rem .75rem; min-height:38px;
                  display:flex; align-items:center; background:#fff; }
    .info-label { font-size:.75rem; color:#6c757d; margin-bottom:.2rem; }
    .sect-card  { border:1px solid #dee2e6; border-radius:.5rem; overflow:hidden; margin-bottom:1.25rem; }
    .sect-hdr   { background:#f8f9fa; padding:.5rem .75rem; font-weight:600; border-bottom:1px solid #dee2e6;
                  display:flex; justify-content:space-between; align-items:center; }
    .cur-block  { border:1px solid #dee2e6; border-radius:.5rem; overflow:hidden; margin:.75rem; }
    .cur-hdr    { background:#f8f9fa; padding:.35rem .7rem; font-weight:600; font-size:.85rem;
                  border-bottom:1px solid #dee2e6; }
    .tbl-compact{ font-size:.83rem; }
    .tbl-compact th { font-size:.75rem; text-transform:none; }
</style>

<!-- ── Page header ───────────────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <span class="text-muted small"><a asp-page="/Products/Index" class="text-muted">← Продукты</a></span>
        <h5 class="mb-0 fw-bold mt-1">Продукт @p.Code</h5>
    </div>
    <div class="d-flex gap-2">
        @if (!edit)
        {
            <a asp-page="/Products/Details" asp-route-code="@p.Code" asp-route-edit="true"
               class="btn btn-outline-secondary btn-sm">Редактировать</a>
        }
        else
        {
            <form method="post" asp-page-handler="Delete" class="d-inline"
                  onsubmit="return confirm('Удалить продукт @p.Code — @p.Name?')">
                <input type="hidden" name="code" value="@p.Code" />
                <button class="btn btn-outline-danger btn-sm">Удалить продукт</button>
            </form>
        }
    </div>
</div>

<!-- ── Basic info form ───────────────────────────────────────────────────── -->
<form id="basicForm" method="post" asp-page-handler="UpdateBasic">
    <input type="hidden" name="code" value="@p.Code" />

    <div class="row g-2 mb-3" style="max-width:760px">
        <div class="col-md-3">
            <div class="info-label">код продукта</div>
            <div class="info-box mono">@p.Code</div>
        </div>
        <div class="col-md-9">
            <div class="info-label">название продукта</div>
            @if (edit)
            {
                <input type="text" name="name" value="@p.Name" class="form-control" required />
            }
            else
            {
                <div class="info-box fw-semibold">@p.Name</div>
            }
        </div>

        <div class="col-md-4">
            <div class="info-label">базис начисления</div>
            @if (edit)
            {
                <select name="accrualBasis" class="form-select">
                    @foreach (var v in new[]{"ACT/ACT","ACT/360","ACT/365F","30/360"})
                    {
                        if (v == p.AccrualBasis) { <option value="@v" selected>@v</option> }
                        else { <option value="@v">@v</option> }
                    }
                </select>
            }
            else
            {
                <div class="info-box"><span class="badge bg-secondary">@p.AccrualBasis</span></div>
            }
        </div>
        <div class="col-md-4">
            <div class="info-label">тип баланса</div>
            @if (edit)
            {
                <select name="balanceType" class="form-select">
                    @foreach (var v in Enum.GetValues<BalanceAccountType>())
                    {
                        if (v == p.BalanceType) { <option value="@v" selected>@v</option> }
                        else { <option value="@v">@v</option> }
                    }
                </select>
            }
            else
            {
                <div class="info-box">
                    @{ var btCls = p.BalanceType switch {
                        BalanceAccountType.Active     => "bg-primary",
                        BalanceAccountType.Passive    => "bg-success",
                        BalanceAccountType.OffBalance => "bg-secondary",
                        _ => "bg-secondary" }; }
                    <span class="badge @btCls">@p.BalanceType</span>
                </div>
            }
        </div>
        @if (edit)
        {
            <div class="col-md-4">
                <div class="info-label">лимит овердрафта (умолч.)</div>
                <input type="number" name="defaultOverdraftLimit" step="0.01" min="0"
                       value="@p.DefaultOverdraftLimit" class="form-control" />
            </div>
        }
    </div>
</form>

<!-- ══════════════════════════════════════════════════════════════════════════
     Section: Балансы
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="sect-card">
    <div class="sect-hdr">
        <span>Балансы</span>
        @if (edit)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary"
                        onclick="openAddBalance()">Add</button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        id="btnEditBal" disabled
                        onclick="openEditBalance()">Edit</button>
                <button type="button" class="btn btn-sm btn-outline-danger"
                        id="btnDelBal" disabled
                        onclick="submitDeleteBalance()">Delete</button>
            </div>
        }
    </div>

    @if (!p.ProductBalances.Any())
    {
        <div class="text-muted small text-center py-3">Балансы не назначены</div>
    }

    @foreach (var grp in balanceGroups)
    {
        <div class="cur-block">
            <div class="cur-hdr"><span class="badge bg-primary me-1">@grp.Key</span></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 tbl-compact">
                    <thead class="table-light">
                        <tr>
                            @if (edit) { <th style="width:32px"></th> }
                            <th>#</th>
                            <th>currency</th>
                            <th>balance code</th>
                            <th>Description</th>
                            <th>balance address</th>
                            <th>GL balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 1; }
                        @foreach (var b in grp)
                        {
                            <tr data-bal-id="@b.Id"
                                data-bal-code="@b.BalanceCode"
                                data-bal-name="@Html.Raw(b.BalanceName.Replace("\"","&quot;"))"
                                data-bal-gl="@b.GlCode">
                                @if (edit)
                                {
                                    <td>
                                        <input type="checkbox" class="bal-chk form-check-input"
                                               value="@b.Id" onchange="onBalChk(this)" />
                                    </td>
                                }
                                <td class="text-muted">@rowNum</td>
                                <td><span class="badge bg-light text-dark border">@b.CurrencyCode</span></td>
                                <td class="mono fw-semibold">@b.BalanceCode</td>
                                <td>@b.BalanceName</td>
                                <td class="mono">@b.BalanceAddress.ToString("D10")</td>
                                <td class="mono text-muted">@(string.IsNullOrEmpty(b.GlCode) ? "—" : b.GlCode)</td>
                            </tr>
                            rowNum++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- hidden delete-balance form -->
<form id="frmDelBal" method="post" asp-page-handler="DeleteProductBalance" style="display:none">
    <input type="hidden" name="code" value="@p.Code" />
    <input type="hidden" name="balanceId" id="delBalId" />
</form>

<!-- ══════════════════════════════════════════════════════════════════════════
     Section: Список адресов баланса (долг)
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="sect-card">
    <div class="sect-hdr">
        <span>список адресов баланса представляющих долг</span>
        @if (edit)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary"
                        onclick="openAddDebt()">Add</button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        id="btnEditDebt" disabled
                        onclick="openEditDebt()">Edit</button>
                <button type="button" class="btn btn-sm btn-outline-danger"
                        id="btnDelDebt" disabled
                        onclick="submitDeleteDebt()">Delete</button>
            </div>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0 tbl-compact">
            <thead class="table-light">
                <tr>
                    @if (edit) { <th style="width:32px"></th> }
                    <th>номер</th>
                    <th>валюта</th>
                    <th>адрес баланса</th>
                </tr>
            </thead>
            <tbody>
                @if (!p.DebtBalanceAddresses.Any())
                {
                    <tr>
                        <td colspan="@(edit ? 4 : 3)" class="text-muted text-center py-3">Нет адресов</td>
                    </tr>
                }
                @{ int dNum = 1; }
                @foreach (var d in p.DebtBalanceAddresses.OrderBy(x => x.Currency).ThenBy(x => x.Address))
                {
                    <tr data-debt-addr="@d.Address" data-debt-cur="@d.Currency">
                        @if (edit)
                        {
                            <td>
                                <input type="checkbox" class="debt-chk form-check-input"
                                       value="@d.Address|@d.Currency" onchange="onDebtChk(this)" />
                            </td>
                        }
                        <td class="text-muted">@dNum</td>
                        <td><span class="badge bg-light text-dark border">@d.Currency</span></td>
                        <td class="mono">@d.Address.ToString("D10")</td>
                    </tr>
                    dNum++;
                }
            </tbody>
        </table>
    </div>
</div>

<!-- hidden delete-debt form -->
<form id="frmDelDebt" method="post" asp-page-handler="RemoveDebtAddress" style="display:none">
    <input type="hidden" name="code" value="@p.Code" />
    <input type="hidden" name="address" id="delDebtAddr" />
    <input type="hidden" name="currency" id="delDebtCur" />
</form>

<!-- ══════════════════════════════════════════════════════════════════════════
     Section: Массив ставок
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="sect-card">
    <div class="sect-hdr">
        <span>массив ставок</span>
        @if (edit)
        {
            <button type="button" class="btn btn-sm btn-outline-primary"
                    onclick="document.getElementById('addRatePanel').style.display='block'; this.style.display='none'">+</button>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0 tbl-compact">
            <thead class="table-light">
                <tr>
                    <th>код ставки</th>
                    <th>Название ставки</th>
                    <th>список адресов баланса (ФИ коды)</th>
                    @if (edit) { <th></th> }
                </tr>
            </thead>
            <tbody>
                @if (!p.Rates.Any())
                {
                    <tr>
                        <td colspan="@(edit ? 4 : 3)" class="text-muted text-center py-3">Нет ставок</td>
                    </tr>
                }
                @foreach (var r in p.Rates)
                {
                    var linked = Model.LinkedRates.FirstOrDefault(x => x.Code == r.Code);
                    <tr>
                        <td class="mono fw-semibold">@r.Code</td>
                        <td>@r.Name @(linked != null ? $"({linked.CurrentRate:F2}%)" : "")</td>
                        <td class="mono text-muted">@string.Join(", ", r.FinancialIndicatorCodes)</td>
                        @if (edit)
                        {
                            <td>
                                <form method="post" asp-page-handler="RemoveRate" class="d-inline">
                                    <input type="hidden" name="code" value="@p.Code" />
                                    <input type="hidden" name="rateCode" value="@r.Code" />
                                    <button class="btn btn-sm btn-outline-danger py-0">✕</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (edit)
    {
        <div id="addRatePanel" style="display:none" class="p-2 border-top bg-light">
            @if (!Model.AllRates.Any())
            {
                <div class="text-muted small py-1">
                    Ставки не заведены. <a asp-page="/Rates/Index">Перейти к ставкам →</a>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="AddRate" class="row g-2 align-items-end">
                    <input type="hidden" name="code" value="@p.Code" />
                    <div class="col-7">
                        <label class="form-label form-label-sm">Ставка <span class="text-danger">*</span></label>
                        <select name="rateCode" class="form-select form-select-sm" required
                                onchange="syncRateName(this)">
                            <option value="">— выберите ставку —</option>
                            @foreach (var r in Model.AllRates.OrderBy(r => r.Code))
                            {
                                var alreadyAdded = p.Rates.Any(x => x.Code == r.Code);
                                if (alreadyAdded)
                                {
                                    <option value="@r.Code" data-name="@r.Name" disabled>
                                        @r.Code — @r.Name (@r.CurrentRate.ToString("F2") %) [уже добавлена]
                                    </option>
                                }
                                else
                                {
                                    <option value="@r.Code" data-name="@r.Name">
                                        @r.Code — @r.Name (@r.CurrentRate.ToString("F2") %)
                                    </option>
                                }
                            }
                        </select>
                        <input type="hidden" name="rateName" id="addRateNameHidden" />
                    </div>
                    <div class="col-3">
                        <label class="form-label form-label-sm">ФИ коды</label>
                        <input name="fiCodes" type="text" class="form-control form-control-sm"
                               placeholder="001" value="001" />
                    </div>
                    <div class="col-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">+</button>
                    </div>
                </form>
            }
        </div>
    }
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     Section: Dictionary of interest
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="sect-card">
    <div class="sect-hdr">
        <span>dictionary of interest</span>
        @if (edit)
        {
            <button type="button" class="btn btn-sm btn-outline-primary"
                    onclick="document.getElementById('addDictPanel').style.display='block'; this.style.display='none'">+</button>
        }
    </div>

    @if (p.DictionaryOfInterest.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 tbl-compact">
                <thead class="table-light">
                    <tr>
                        <th>сумма</th>
                        <th>модификатор ставки</th>
                        @if (edit) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kv in p.DictionaryOfInterest)
                    {
                        <tr>
                            <td class="mono">@kv.Key.ToString("N2")</td>
                            <td class="mono @(kv.Value >= 0 ? "text-success" : "text-danger")">@kv.Value</td>
                            @if (edit)
                            {
                                <td>
                                    <form method="post" asp-page-handler="RemoveDictEntry" class="d-inline">
                                        <input type="hidden" name="code" value="@p.Code" />
                                        <input type="hidden" name="threshold" value="@kv.Key" />
                                        <button class="btn btn-sm btn-outline-danger py-0">✕</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-muted small text-center py-3">Таблица пуста</div>
    }

    @if (edit)
    {
        <div id="addDictPanel" style="display:none" class="p-2 border-top bg-light">
            <form method="post" asp-page-handler="AddDictEntry" class="row g-2 align-items-end">
                <input type="hidden" name="code" value="@p.Code" />
                <div class="col-4"><label class="form-label form-label-sm">Сумма (порог)</label>
                    <input name="threshold" type="number" step="0.01" class="form-control form-control-sm" placeholder="1000" /></div>
                <div class="col-4"><label class="form-label form-label-sm">Модификатор (%)</label>
                    <input name="modifier" type="number" step="0.01" class="form-control form-control-sm" placeholder="-1" /></div>
                <div class="col-4">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Добавить</button>
                </div>
            </form>
        </div>
    }
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     Section: Links (feature flags)
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="sect-card">
    <div class="sect-hdr"><span>Links</span></div>
    <div class="p-3">
        @if (edit)
        {
            <div class="mb-2">
                <input type="checkbox" name="supportsStandingOrders" value="true"
                       form="basicForm" class="form-check-input me-2"
                       @(p.SupportsStandingOrders ? "checked" : "") />
                <label>link: список постоянных поручений</label>
            </div>
            <div class="mb-2">
                <input type="checkbox" name="supportsDirectDebit" value="true"
                       form="basicForm" class="form-check-input me-2"
                       @(p.SupportsDirectDebit ? "checked" : "") />
                <label>link: структура direct debit</label>
            </div>
            <div class="mb-2">
                <input type="checkbox" name="supportsAuthorizationHolds" value="true"
                       form="basicForm" class="form-check-input me-2"
                       @(p.SupportsAuthorizationHolds ? "checked" : "") />
                <label>link: структура authorization hold</label>
            </div>
            <div class="mb-2">
                <input type="checkbox" name="supportsPendingObligationQueue" value="true"
                       form="basicForm" class="form-check-input me-2"
                       @(p.SupportsPendingObligationQueue ? "checked" : "") />
                <label>link: pending obligation queue</label>
            </div>
            <div class="mb-2 text-muted">
                <span class="form-check-input me-2" style="display:inline-block;width:1em"></span>
                link: debt list
            </div>
        }
        else
        {
            var flags = new[] {
                (p.SupportsStandingOrders,         "link: список постоянных поручений"),
                (p.SupportsDirectDebit,            "link: структура direct debit"),
                (p.SupportsAuthorizationHolds,     "link: структура authorization hold"),
                (p.SupportsPendingObligationQueue, "link: pending obligation queue"),
                (false,                            "link: debt list"),
            };
            foreach (var (on, label) in flags)
            {
                <div class="mb-1 @(on ? "" : "text-muted")">
                    <span class="me-2">@(on ? "☑" : "☐")</span>@label
                </div>
            }
        }
    </div>
</div>

<!-- ── Save / Cancel (edit mode only) ───────────────────────────────────── -->
@if (edit)
{
    <div class="d-flex gap-2 mt-3 mb-5">
        <button type="submit" form="basicForm" class="btn btn-primary px-4">Save</button>
        <a asp-page="/Products/Details" asp-route-code="@p.Code"
           class="btn btn-outline-secondary">Cancel</a>
    </div>
}

<!-- ══════════════════════════════════════════════════════════════════════════
     Modal: Add Balance
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalAddBal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddProductBalance">
                <input type="hidden" name="code" value="@p.Code" />
                <div class="modal-header">
                    <h6 class="modal-title">Добавить баланс</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label form-label-sm">Определение баланса <span class="text-danger">*</span></label>
                        <select name="balanceDefinitionId" id="addBalDef" class="form-select form-select-sm"
                                onchange="updateAddBalCode()">
                            <option value="">— выберите —</option>
                            @foreach (var d in Model.BalanceDefs.OrderBy(d => d.Code))
                            {
                                <option value="@d.Id" data-code="@d.Code">@d.Code — @d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-5">
                            <label class="form-label form-label-sm">Валюта <span class="text-danger">*</span></label>
                            <select name="currencyCode" class="form-select form-select-sm">
                                @foreach (var c in Model.Currencies.OrderBy(c => c.AlphaCode))
                                {
                                    <option value="@c.AlphaCode">@c.AlphaCode — @c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm">Адрес (10 цифр) <span class="text-danger">*</span></label>
                            <input name="balanceAddress" type="number" id="addBalAddr"
                                   class="form-control form-control-sm mono"
                                   placeholder="0100000001" min="1000000000" max="9999999999" />
                        </div>
                        <div class="col-3">
                            <label class="form-label form-label-sm">GL счет</label>
                            <input name="glCode" type="text" class="form-control form-control-sm mono"
                                   placeholder="00000001" />
                        </div>
                    </div>
                    <div class="mt-2 small text-muted">
                        Код баланса: <span id="addBalCodePreview" class="mono fw-semibold">—</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm">Добавить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     Modal: Edit Balance (GL code)
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalEditBal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpdateProductBalance">
                <input type="hidden" name="code" value="@p.Code" />
                <input type="hidden" name="balanceId" id="editBalId" />
                <div class="modal-header">
                    <h6 class="modal-title">Изменить баланс</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <div class="info-label">Код баланса</div>
                        <div id="editBalCode" class="info-box mono fw-semibold"></div>
                    </div>
                    <div class="mb-2">
                        <div class="info-label">Название</div>
                        <div id="editBalName" class="info-box text-muted"></div>
                    </div>
                    <div>
                        <label class="form-label form-label-sm">GL счет</label>
                        <input type="text" name="glCode" id="editBalGl"
                               class="form-control form-control-sm mono" placeholder="00000001" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     Modal: Add Debt Address
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalAddDebt" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddDebtAddress">
                <input type="hidden" name="code" value="@p.Code" />
                <div class="modal-header">
                    <h6 class="modal-title">Добавить адрес долга</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label form-label-sm">Валюта <span class="text-danger">*</span></label>
                        <select name="currency" class="form-select form-select-sm">
                            @foreach (var c in Model.Currencies.OrderBy(c => c.AlphaCode))
                            {
                                <option value="@c.AlphaCode">@c.AlphaCode — @c.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label form-label-sm">Адрес баланса (10 цифр) <span class="text-danger">*</span></label>
                        <input name="address" type="number" class="form-control form-control-sm mono"
                               placeholder="0100000001" min="1000000000" max="9999999999" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm">Добавить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     Modal: Edit Debt Address
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalEditDebt" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpdateDebtAddress">
                <input type="hidden" name="code" value="@p.Code" />
                <input type="hidden" name="oldAddress" id="editDebtOld" />
                <input type="hidden" name="currency"   id="editDebtCur" />
                <div class="modal-header">
                    <h6 class="modal-title">Изменить адрес долга</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <div class="info-label">Валюта</div>
                        <div id="editDebtCurDisplay" class="info-box"></div>
                    </div>
                    <div>
                        <label class="form-label form-label-sm">Новый адрес (10 цифр)</label>
                        <input type="number" name="newAddress" id="editDebtNewAddr"
                               class="form-control form-control-sm mono"
                               min="1000000000" max="9999999999" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Balance selection ────────────────────────────────────────────────────
let selBal = null;
function onBalChk(cb) {
    document.querySelectorAll('.bal-chk').forEach(c => { if (c !== cb) c.checked = false; });
    selBal = cb.checked ? cb.value : null;
    document.getElementById('btnEditBal').disabled = !selBal;
    document.getElementById('btnDelBal').disabled  = !selBal;
}
function openAddBalance() {
    new bootstrap.Modal(document.getElementById('modalAddBal')).show();
}
function openEditBalance() {
    if (!selBal) return;
    const row = document.querySelector(`tr[data-bal-id="${selBal}"]`);
    document.getElementById('editBalId').value   = selBal;
    document.getElementById('editBalCode').textContent = row.dataset.balCode;
    document.getElementById('editBalName').textContent = row.dataset.balName;
    document.getElementById('editBalGl').value         = row.dataset.balGl;
    new bootstrap.Modal(document.getElementById('modalEditBal')).show();
}
function submitDeleteBalance() {
    if (!selBal || !confirm('Удалить выбранный баланс?')) return;
    document.getElementById('delBalId').value = selBal;
    document.getElementById('frmDelBal').submit();
}
// ── Rate selection ───────────────────────────────────────────────────────
function syncRateName(sel) {
    const opt = sel.selectedOptions[0];
    document.getElementById('addRateNameHidden').value = opt ? (opt.dataset.name || '') : '';
}

function updateAddBalCode() {
    const opt = document.getElementById('addBalDef').selectedOptions[0];
    const code = opt ? (opt.dataset.code || '—') : '—';
    document.getElementById('addBalCodePreview').textContent = code;
    if (code !== '—') {
        const prefix = code.substring(0, 2);
        const addr = document.getElementById('addBalAddr');
        if (!addr.value) addr.value = prefix + '00000001';
    }
}

// ── Debt selection ───────────────────────────────────────────────────────
let selDebt = null;
function onDebtChk(cb) {
    document.querySelectorAll('.debt-chk').forEach(c => { if (c !== cb) c.checked = false; });
    selDebt = cb.checked ? cb.value : null;  // "address|currency"
    document.getElementById('btnEditDebt').disabled = !selDebt;
    document.getElementById('btnDelDebt').disabled  = !selDebt;
}
function openAddDebt() {
    new bootstrap.Modal(document.getElementById('modalAddDebt')).show();
}
function openEditDebt() {
    if (!selDebt) return;
    const [addr, cur] = selDebt.split('|');
    document.getElementById('editDebtOld').value        = addr;
    document.getElementById('editDebtCur').value        = cur;
    document.getElementById('editDebtCurDisplay').textContent = cur;
    document.getElementById('editDebtNewAddr').value    = addr;
    new bootstrap.Modal(document.getElementById('modalEditDebt')).show();
}
function submitDeleteDebt() {
    if (!selDebt || !confirm('Удалить выбранный адрес долга?')) return;
    const [addr, cur] = selDebt.split('|');
    document.getElementById('delDebtAddr').value = addr;
    document.getElementById('delDebtCur').value  = cur;
    document.getElementById('frmDelDebt').submit();
}
</script>
}
