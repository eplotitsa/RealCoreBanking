@page
@model RealCoreBanking.Pages.InterestRates.CreateModel
@{
    ViewData["Title"] = "Создать ставку";
}

<div class="row justify-content-center">
<div class="col-xl-8">

<a asp-page="/InterestRates/Index" class="text-muted text-decoration-none small">← Ставки и индексы</a>
<h4 class="mt-1 mb-4 fw-bold">Новая процентная ставка</h4>

<form method="post">
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold">Основные параметры</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label form-label-sm">Код</label>
                    <input asp-for="Code" type="number" class="form-control" placeholder="2021" required />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label form-label-sm">Название</label>
                    <input asp-for="Name" class="form-control" placeholder="current account rate php" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label class="form-label form-label-sm">Валюта</label>
                    <input asp-for="Currency" class="form-control" maxlength="3" />
                </div>
                <div class="col-md-2">
                    <label class="form-label form-label-sm">Назначение</label>
                    <select asp-for="Purpose" class="form-select"
                            asp-items="Html.GetEnumSelectList<RealCoreBanking.Core.Models.InterestRatePurpose>()"></select>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold">Тип и значение</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Тип ставки</label>
                    <select asp-for="Type" class="form-select"
                            asp-items="Html.GetEnumSelectList<RealCoreBanking.Core.Models.InterestRateType>()"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Текущая ставка (%)</label>
                    <input asp-for="CurrentRate" type="number" step="0.0001" class="form-control mono"
                           placeholder="15.00" id="currentRateField" />
                    <div class="form-text" id="rateFromIndex" style="display:none">
                        &#8593; будет унаследована от индекса
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Действует с</label>
                    <input asp-for="EffectiveFrom" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Действует по</label>
                    <input asp-for="EffectiveTo" type="date" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold">Индекс и периодичность</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label form-label-sm">Код индекса</label>
                    <select asp-for="RateIndexCode" class="form-select">
                        <option value="">— нет —</option>
                        @foreach (var idx in Model.Indexes)
                        {
                            <option value="@idx.Code">@idx.Code — @idx.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Период обновления</label>
                    <select asp-for="UpdatePeriod" class="form-select"
                            asp-items="Html.GetEnumSelectList<RealCoreBanking.Core.Models.InterestUpdatePeriod>()"></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label form-label-sm">Лаг фиксации (дн.)</label>
                    <input asp-for="FixingLagDays" type="number" class="form-control" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Лаг уведомления (дн.)</label>
                    <input asp-for="NotificationLagDays" type="number" class="form-control" min="0" />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold">Корректировка и округление</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Спред (%)</label>
                    <input asp-for="Spread" type="number" step="0.01" class="form-control mono" />
                </div>
                <div class="col-md-2">
                    <label class="form-label form-label-sm">Мультипликатор</label>
                    <input asp-for="Multiplier" type="number" step="0.001" class="form-control mono" />
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Шаг округления (%)</label>
                    <input asp-for="RoundingStep" type="number" step="0.001" class="form-control mono" />
                </div>
                <div class="col-md-4">
                    <label class="form-label form-label-sm">Правило округления</label>
                    <select asp-for="RoundingRule" class="form-select"
                            asp-items="Html.GetEnumSelectList<RealCoreBanking.Core.Enums.RoundingRule>()"></select>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">Ограничения</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label form-label-sm">Пол (Floor, %)</label>
                    <input asp-for="Floor" type="number" step="0.01" class="form-control mono" />
                </div>
                <div class="col-md-4">
                    <label class="form-label form-label-sm">Кап (Cap, %)</label>
                    <input asp-for="Cap" type="number" step="0.01" class="form-control mono" />
                </div>
                <div class="col-md-4">
                    <label class="form-label form-label-sm">Регуляторный макс. (%)</label>
                    <input asp-for="RegulatoryMax" type="number" step="0.01" class="form-control mono" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4">Создать ставку</button>
        <a asp-page="/InterestRates/Index" class="btn btn-outline-secondary">Отмена</a>
    </div>
</form>

@section Scripts {
<script>
    // when an index is selected, indicate that currentRate will be derived from it
    document.getElementById('RateIndexCode').addEventListener('change', function() {
        var hint = document.getElementById('rateFromIndex');
        var field = document.getElementById('currentRateField');
        if (this.value) {
            hint.style.display = '';
            field.classList.add('bg-light');
        } else {
            hint.style.display = 'none';
            field.classList.remove('bg-light');
        }
    });
</script>
}

</div>
</div>
