@inject RealCoreBanking.Services.AccountStore _layoutStore
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — RealCoreBanking</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f5f7fa; }
        .navbar-brand { font-weight: 700; letter-spacing: .5px; }
        .table th { font-size: .8rem; text-transform: uppercase; letter-spacing: .5px; }
        .mono { font-family: 'Courier New', monospace; font-size: .85rem; }
        .event-log { background: #1e1e1e; color: #d4d4d4; font-family: 'Courier New', monospace;
                     font-size: .8rem; max-height: 180px; overflow-y: auto; padding: .5rem .75rem; border-radius: .375rem; }
        .dropdown-header { font-size: .7rem; font-weight: 700; text-transform: uppercase;
                           letter-spacing: .8px; color: #6c757d; padding: .4rem 1rem .1rem; }
        .navbar-nav .dropdown-menu { min-width: 220px; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand navbar-dark bg-dark shadow-sm mb-4">
    <div class="container-fluid px-3">
        <a class="navbar-brand" asp-page="/Index">&#127968; RealCoreBanking</a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                <!-- ═══ Продукты и счета ═══ -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#"
                       data-bs-toggle="dropdown" role="button" aria-expanded="false">
                        Продукты и счета
                    </a>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header">Продукты</h6></li>
                        <li><a class="dropdown-item" asp-page="/Products/Create">&#43; Создать продукт</a></li>
                        <li><a class="dropdown-item" asp-page="/Products/Index">Список продуктов</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Балансы</h6></li>
                        <li><a class="dropdown-item" asp-page="/Balances/Index">Определения балансов</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Счета</h6></li>
                        <li><a class="dropdown-item" asp-page="/Account/Open">&#43; Открыть счет</a></li>
                        <li><a class="dropdown-item" asp-page="/Index">Список счетов</a></li>
                    </ul>
                </li>

                <!-- ═══ Ставки и индексы ═══ -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#"
                       data-bs-toggle="dropdown" role="button" aria-expanded="false">
                        Ставки и индексы
                    </a>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header">Процентные ставки</h6></li>
                        <li><a class="dropdown-item" asp-page="/InterestRates/Create">&#43; Создать ставку</a></li>
                        <li><a class="dropdown-item" asp-page="/InterestRates/Index">Список ставок</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Индексы ставок</h6></li>
                        <li><a class="dropdown-item" asp-page="/InterestRates/CreateIndex">&#43; Создать индекс</a></li>
                        <li><a class="dropdown-item" asp-page="/InterestRates/Index">Список индексов</a></li>
                    </ul>
                </li>

                <!-- ═══ Справочники ═══ -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#"
                       data-bs-toggle="dropdown" role="button" aria-expanded="false">
                        Справочники
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-page="/Currencies/Index">&#128180; Валюты</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-page="/BalanceTypes/Index">Типы баланса</a></li>
                        <li><a class="dropdown-item" asp-page="/FinancialIndicators/Index">Финансовые признаки</a></li>
                    </ul>
                </li>

                <!-- ═══ Система ═══ -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#"
                       data-bs-toggle="dropdown" role="button" aria-expanded="false">
                        Система
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-page="/Enterprise/Index">&#128467; Банковская дата</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" asp-page="/Enterprise/Index" asp-page-handler="Stop"
                                  class="px-3 py-1"
                                  onsubmit="return confirm('Остановить приложение?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                    &#9632; Остановить
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>

            </ul>

            <!-- Banking date badge -->
            <span class="navbar-text small ms-2">
                <span class="badge bg-secondary">
                    &#128467; @_layoutStore.Enterprise.BankingDate.ToString("dd.MM.yyyy")
                </span>
            </span>
        </div>
    </div>
</nav>

<div class="container-fluid px-4 pb-5">
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
